# OpenSSH for Android accounts (Android itself has no /etc/passwd).
# name:home:shell
#   home  - empty keeps the default (/data/root, /data/shell, app data dir)
#   shell - interactive shell for ssh logins and adb shell; commands, scp,
#           sftp and rsync always use /system/bin/sh.
# Change shells with: sshdctl shell <user> sh|zsh|bash
root:/data/root:/system/bin/sh
shell:/data/shell:/system/bin/sh
