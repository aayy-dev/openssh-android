[submodule "openssh-portable"]
	path = openssh-portable
	url = https://github.com/openssh/openssh-portable
[submodule "openssl"]
	path = openssl
	url = https://github.com/openssl/openssl
[submodule "zlib"]
	path = zlib
	url = https://github.com/madler/zlib
[submodule "bash"]
	path = bash
	url = https://git.savannah.gnu.org/git/bash.git
[submodule "zsh"]
	path = zsh
	url = https://github.com/zsh-users/zsh
[submodule "ncurses"]
	path = ncurses
	url = https://github.com/ThomasDickey/ncurses-snapshots
[submodule "rsync"]
	path = rsync
	url = https://github.com/RsyncProject/rsync
